# Read Verilog file
read_verilog -sv coo.v

# Set top module
hierarchy -check -top coo_spmv_8bank

# Synthesis steps
proc
opt
fsm
opt
memory
techmap
opt

# Map to library
dfflibmap -liberty ../libs/asap7.lib
abc -liberty ../libs/asap7.lib
opt

# Output netlist and report
write_verilog -noattr synthesized_coo.v
tee -o ../../../data/verilog/int8/coo.out stat -liberty ../libs/asap7.lib
