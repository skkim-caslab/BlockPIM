# Read Verilog file
read_verilog -sv dense.v

# Set top module
hierarchy -check -top dense_spmv_8bank

# Synthesis steps
proc
opt
fsm
opt
memory
techmap
opt

# Map to library
dfflibmap -liberty ../libs/asap7.lib
abc -liberty ../libs/asap7.lib
opt

# Output netlist and report
write_verilog -noattr synthesized_dense.v
tee -o ../../../data/verilog/int8/dense.out stat -liberty ../libs/asap7.lib
