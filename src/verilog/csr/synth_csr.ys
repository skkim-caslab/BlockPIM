# Read Verilog file
read_verilog -sv csr.v

# Set top module
hierarchy -check -top csr_spmv_8bank

# Synthesis steps
proc
opt
fsm
opt
memory
techmap
opt

# Map to library
dfflibmap -liberty ../libs/asap7.lib
abc -liberty ../libs/asap7.lib
opt

# Output netlist and report
write_verilog -noattr synthesized_csr.v
tee -o ../../../data/verilog/int8/csr.out stat -liberty ../libs/asap7.lib
