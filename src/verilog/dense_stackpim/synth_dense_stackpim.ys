# Read Verilog file
read_verilog -sv dense_stackpim.v

# Set top module (ELEMENTS = 32-byte block)
hierarchy -check -top dense_stackpim_spmv_8bank -chparam ELEMENTS 32

# Synthesis steps
proc
opt
fsm
opt
memory
techmap
opt

# Map to library
dfflibmap -liberty ../libs/asap7.lib
abc -liberty ../libs/asap7.lib
opt

# Output netlist and report
write_verilog -noattr synthesized_dense_stackpim.v
tee -o ../../../data/verilog/int8/dense_stackpim_32.out stat -liberty ../libs/asap7.lib
